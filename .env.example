# Copy this file to ~/.env (or .env in the repo root, both are loaded) and fill in real values.
# Never commit your actual .env file.

# Qwen2-VL-max via DashScope (Alibaba Cloud) — used by the core agent (models/qwen.py)
# and the DocVQA/FUNSD/SEC-10K/bank-statement evaluations.
DASHSCOPE_API_KEY=

# GPT-4o baseline comparison evaluations (evaluation/*_gpt4o_eval.py)
OPENAI_API_KEY=

# Gemini baseline comparison evaluations (evaluation/*_gemini_eval.py)
GEMINI_API_KEY_2=

# Kimi (Moonshot AI) baseline comparison evaluations (evaluation/*_kimi_eval.py)
KIMI_API_KEY=

# Optional. Only needed if `poppler` (used by pdf2image to rasterize PDF pages) isn't
# already on your PATH — e.g. a conda-installed poppler. Leave unset otherwise.
POPPLER_PATH=

# Gemma/InternVL/SmolVLM evaluations run local Hugging Face models and need no API key,
# but do need the model weights downloaded (see README) and a GPU for reasonable speed.